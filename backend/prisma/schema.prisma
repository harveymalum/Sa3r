generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum UserRole { USER ADMIN STORE }
model User {
  id String @id @default(cuid())
  name String?
  phone String? @unique
  email String? @unique
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  alerts PriceAlert[]
}
model Store {
  id String @id @default(cuid())
  name String
  website String?
  affiliateUrl String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  offers Offer[]
}
model Product {
  id String @id @default(cuid())
  name String
  brand String?
  model String?
  category String
  imageUrl String?
  description String?
  specsJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offers Offer[]
  priceHistory PriceHistory[]
  alerts PriceAlert[]
}
model Offer {
  id String @id @default(cuid())
  productId String
  storeId String
  price Decimal @db.Decimal(12,2)
  oldPrice Decimal? @db.Decimal(12,2)
  shippingCost Decimal @default(0) @db.Decimal(12,2)
  productUrl String?
  active Boolean @default(true)
  updatedAt DateTime @updatedAt
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
  store Store @relation(fields:[storeId], references:[id], onDelete:Cascade)
}
model PriceHistory {
  id String @id @default(cuid())
  productId String
  storeId String?
  price Decimal @db.Decimal(12,2)
  recordedAt DateTime @default(now())
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
}
model PriceAlert {
  id String @id @default(cuid())
  userId String
  productId String
  targetPrice Decimal @db.Decimal(12,2)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  product Product @relation(fields:[productId], references:[id], onDelete:Cascade)
}
